{
  "name": "crypto-notepad",
  "private": true,
  "description": "Текстовый редактор с клиентским шифрованием (Zero-Knowledge Cloud Notepad)",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc -p packages/crypto --noEmit && tsc -p apps/api --noEmit",
    "check": "npm run typecheck && npm test",
    "dev:api": "npm run dev -w @cn/api"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
