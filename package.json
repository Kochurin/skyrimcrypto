{
  "name": "skyrimcrypto",
  "private": true,
  "description": "SkyrimCrypto — текстовый редактор с клиентским шифрованием (Zero-Knowledge Cloud Notepad)",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run packages/crypto --coverage",
    "test:e2e": "playwright test",
    "test:load": "node scripts/load.mjs",
    "typecheck": "tsc -p packages/crypto --noEmit && tsc -p apps/api --noEmit && tsc -p apps/web --noEmit",
    "check": "npm run typecheck && npm test && npm run test:coverage",
    "dev:api": "npm run dev -w @cn/api",
    "dev:web": "npm run dev -w @cn/web",
    "build:web": "npm run build -w @cn/web",
    "set-role": "npm run set-role -w @cn/api --"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.12",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
