# Локальная разработка (этап 2). Скопируйте в .env и при необходимости поменяйте.
POSTGRES_USER=notepad
POSTGRES_PASSWORD=change-me-local
POSTGRES_DB=notepad
DATABASE_URL=postgres://notepad:change-me-local@localhost:5432/notepad

MINIO_ROOT_USER=notepad
MINIO_ROOT_PASSWORD=change-me-local-minio
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=notes

# Учётные записи (этап 4). Секрет подписи JWT: длинная случайная строка.
# Если не задан, сервер создаёт случайный при запуске — после перезапуска все выходят из учётных записей.
JWT_SECRET=
# true — cookie сессии только по HTTPS (обязательно в продакшене)
COOKIE_SECURE=false
# Очистка удалённых и просроченных заметок, минут
PURGE_INTERVAL_MINUTES=60
