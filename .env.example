# Локальная разработка (этап 2). Скопируйте в .env и при необходимости поменяйте.
POSTGRES_USER=notepad
POSTGRES_PASSWORD=change-me-local
POSTGRES_DB=notepad
DATABASE_URL=postgres://notepad:change-me-local@localhost:5432/notepad

MINIO_ROOT_USER=notepad
MINIO_ROOT_PASSWORD=change-me-local-minio
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=notes

# Учётные записи (этап 4). Секрет подписи JWT: длинная случайная строка.
# Если не задан, сервер создаёт случайный при запуске — после перезапуска все выходят из учётных записей.
JWT_SECRET=
# true — cookie сессии только по HTTPS (обязательно в продакшене)
COOKIE_SECURE=false
# Очистка удалённых и просроченных заметок, минут
PURGE_INTERVAL_MINUTES=60

# Этап 5 — защита
# Сколько прокси перед API (за Caddy — 1). IP клиента берётся только из записи, добавленной ими
TRUST_PROXY_HOPS=0
# NFR-11: запросов к API в минуту с одного IP; вход и регистрация — отдельно
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=20
# FR-12: больше NOT_FOUND_MAX ответов 404 за NOT_FOUND_WINDOW_MIN минут — блокировка на BLOCK_HOURS часов
NOT_FOUND_MAX=100
NOT_FOUND_WINDOW_MIN=10
BLOCK_HOURS=24
# Белый список адресов, которые не блокируются (через запятую)
IP_ALLOWLIST=
# FR-13: сколько дней хранить журнал безопасности
SECURITY_LOG_DAYS=180
